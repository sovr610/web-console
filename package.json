{
  "name": "web-console",
  "version": "1.0.0",
  "description": "A light weight developer console for mobile device debugging.",
  "main": "dist/web-console-bundle.js",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:vanilla": "webpack --mode production --config-name vanilla",
    "build:react": "webpack --mode production --config-name react",
    "build:angular": "webpack --mode production --config-name angular",
    "build:vue": "webpack --mode production --config-name vue",
    "build:svelte": "webpack --mode production --config-name svelte",
    "build:solid": "webpack --mode production --config-name solid",
    "watch": "webpack --mode development --watch",
    "serve": "webpack serve --mode development",
    "serve:react": "webpack serve --mode development --open /example/react-example.html",
    "serve:angular": "webpack serve --mode development --open /example/angular-example.html",
    "serve:vue": "webpack serve --mode development --open /example/vue-example.html",
    "serve:svelte": "webpack serve --mode development --open /example/svelte-example.html",
    "serve:solid": "webpack serve --mode development --open /example/solid-example.html",
    "serve:prod": "webpack serve --mode production",
    "analyze": "webpack --mode production --profile --json > stats.json && webpack-bundle-analyzer stats.json dist",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovr610/web-console.git"
  },
  "keywords": [
    "web",
    "console",
    "mobile",
    "debugger",
    "event",
    "logger",
    "phone"
  ],
  "author": "Parker Bidigare (work.simpleintelligence@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sovr610/web-console/issues"
  },
  "homepage": "https://github.com/sovr610/web-console#readme",
  "devDependencies": {
    "@angular/compiler-cli": "^18.1.3",
    "@angular/platform-browser-dynamic": "^18.1.3",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vue/compiler-sfc": "^3.4.35",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "rimraf": "^6.1.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vue-loader": "^17.3.1",
    "webpack": "^5.93.0",
    "webpack-bundle-analyzer": "^5.2.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@angular/core": "^18.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.11",
    "svelte": "^4.2.20",
    "svelte-loader": "^3.2.4",
    "vue": "^3.4.35"
  }
}
